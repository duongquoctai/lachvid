# ==============================================================================
# LachVid Environment Configuration (Template)
# ==============================================================================

# Port của Next.js Frontend
PORT=3000

# URL của Python Backend Microservice (FastAPI + PySceneDetect)
# - Ở Local: http://localhost:8000
# - Ở Cloud A (Vercel): Điền URL deploy của Backend trên Railway / Render / Fly.io
#   (Ví dụ: https://lachvid-python-production.up.railway.app)
PYTHON_BACKEND_URL=http://localhost:8000

# Zvid.io API Key (Lấy tại https://app.zvid.io/api-keys)
# ZVID_API_KEY=zvid_live_xxxxxxxxxxxxxxxxxxxx

# Zvid Webhook Secret (Tuỳ chọn: Dùng để verify chữ ký HMAC-SHA256 khi nhận webhook)
# ZVID_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
